# Production build-time variables
# ------------------------------------------------------------------
# Vite INLINES VITE_* values into the JS bundle during `npm run build`.
# Cloudflare runtime "Variables and secrets" are injected only AFTER the
# build (at request time), so they can never reach import.meta.env.VITE_*.
# Therefore the real values must be present here (or in CI env vars)
# when the Cloudflare Git integration runs `npm run build`.
# This file is committed to the repo — VITE_* values are public by design.
VITE_API_URL=https://investordocbackend.onrender.com
VITE_GOOGLE_CLIENT_ID=1010491528139-f83trligjllh2gbk5kkpjakrgkoq3m6f.apps.googleusercontent.com