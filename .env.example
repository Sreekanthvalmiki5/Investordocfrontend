# Copy this file to `.env` for local development, or set the values at build
# time (e.g. in `.env.production` or CI env vars) for production deployments.
# NOTE: Vite INLINES VITE_* values into the bundle at build time, so they must
# be present during `npm run build` — runtime-only vars (e.g. Cloudflare
# "Variables and secrets") are injected too late to reach import.meta.env.VITE_*.

# Backend API base URL (no trailing slash) — used as the axios baseURL
VITE_API_URL=https://your-backend.example.com

# Google OAuth client ID (Web application). When set, the "Continue with
# Google" button uses the Google Identity Services popup flow and exchanges the
# ID token with the backend (/api/auth/google). When unset in production, the
# button falls back to the server-side redirect flow (/api/auth/google/login).
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Clerk publishable key. When unset, the app runs against a bundled
# mock auth provider so the demo works out-of-the-box without external keys.
VITE_CLERK_PUBLISHABLE_KEY=
