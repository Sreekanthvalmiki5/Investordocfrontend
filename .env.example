# Base URL for the backend API service layer (axios baseURL).
VITE_API_URL=/api

# Google OAuth client ID (Web application). When set, the "Continue with
# Google" button uses the Google Identity Services popup flow and exchanges the
# ID token with the backend (/api/auth/google). When unset in production, the
# button falls back to the server-side redirect flow (/api/auth/google/login).
VITE_GOOGLE_CLIENT_ID=

# Clerk publishable key. When unset, the app runs against a bundled
# mock auth provider so the demo works out-of-the-box without external keys.
VITE_CLERK_PUBLISHABLE_KEY=
